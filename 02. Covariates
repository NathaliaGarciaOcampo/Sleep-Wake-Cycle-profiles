    (!is.na(Data_UKB$CHD_Prevalence_UK) & Data_UKB$CHD_Prevalence_UK == 1) | 
    (!is.na(Data_UKB$HF_Prevalence_UK) & Data_UKB$HF_Prevalence_UK == 1), 1, 0)


## 2.6) Creating incident disease indicators:

##First CVD event:
#The outcome of interest (CVD) was defined as the incidence of the first fatal or non-fatal CHD, HF and stroke. 
Data_UKB$first_cvd_date_UK <- apply(Data_UKB[, c("hfailure_out_sro_date", "chd_out_sro_date", "stroke_out_sro_date")], 1, function(x) {
  if (all(is.na(x))) NA else min(x, na.rm = TRUE)})
Data_UKB$first_cvd_date_UK <- as.Date(Data_UKB$first_cvd_date_UK)

##Incidence of CVD, CHD, HF & stroke, note that these variables refers to the incidence of the first event.

#CVD incidence:
Data_UKB$CVD_incidence_UK <- ifelse(
  (is.na(Data_UKB$CVD_prevalence_UK) | Data_UKB$CVD_prevalence_UK == 0) &  # Not prevalent CVD at baseline
    (!is.na(Data_UKB$first_cvd_date_UK) & Data_UKB$first_cvd_date_UK > Data_UKB$doacc), 1, 0) # First CVD event AFTER inclusion date

#CHD incidence:
Data_UKB$CHD_incidence_UK <- ifelse(
  !is.na(Data_UKB$CVD_prevalence_UK) & Data_UKB$CVD_prevalence_UK == 0 &
    !is.na(Data_UKB$first_cvd_date_UK) &!is.na(Data_UKB$chd_out_sro_date) &
    Data_UKB$first_cvd_date_UK > Data_UKB$doacc &
    Data_UKB$first_cvd_date_UK == Data_UKB$chd_out_sro_date, 1,0)

#HF incidence:
Data_UKB$HF_incidence_UK <- ifelse(
  !is.na(Data_UKB$CVD_prevalence_UK) & Data_UKB$CVD_prevalence_UK == 0 &
    !is.na(Data_UKB$first_cvd_date_UK) & !is.na(Data_UKB$hfailure_out_sro_date) &
    Data_UKB$first_cvd_date_UK > Data_UKB$doacc &
    Data_UKB$first_cvd_date_UK == Data_UKB$hfailure_out_sro_date, 1, 0)

#Stroke incidence:
Data_UKB$Stroke_incidence_UK <- ifelse(
  !is.na(Data_UKB$CVD_prevalence_UK) & Data_UKB$CVD_prevalence_UK == 0 &
    !is.na(Data_UKB$first_cvd_date_UK) & !is.na(Data_UKB$stroke_out_sro_date) &
    Data_UKB$first_cvd_date_UK > Data_UKB$doacc &
    Data_UKB$first_cvd_date_UK == Data_UKB$stroke_out_sro_date, 1, 0)

## 2.7)  Final population of study
missing_participants <- Data_UKB[is.na(Data_UKB$smoking)| is.na(Data_UKB$livingalone) | is.na(Data_UKB$alcohol_3cat) | is.na(Data_UKB$fruitveg)  | is.na(Data_UKB$bmi_cat) | is.na(Data_UKB$work_cat), ] 
Data_CVD_uk <- Data_UKB[Data_UKB$CVD_prevalence_UK != 1, ] #Removing prevalent CVD cases
sample_cvd_uk <- Data_CVD_uk[complete.cases(Data_CVD_uk[, c("livingalone", "smoking", "alcohol_3cat", "fruitveg", "bmi_cat", "work_cat")]), ]

## 2.8) Downloading the processed dataset 
write.csv(sample_cvd_uk, "path.csv")

