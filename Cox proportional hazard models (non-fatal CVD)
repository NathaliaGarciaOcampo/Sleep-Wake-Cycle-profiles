
#Creating the dataset without CVD fatal cases
sample_cvd_sensitivity_nofatal_uk <- sample_cvd_uk[
  !(sample_cvd_uk$cvd_event_uk == 1 & sample_cvd_uk$fatal_CVD_uk == 1),]

#Cox models:

####Second model:  (cox_cvd_1_uk)+  behavioral factors
cox_cvd_2_uk <- coxph(Surv(age_inclusion, age_inclusion + follow_up_time_cvd_uk, cvd_event_uk) ~ c9  + sex + edu + livingalone + work_cat + smoking +alcohol_3cat + fruitveg_cat,  data = sample_cvd_sensitivity_nofatal_uk)
summary(cox_cvd_2_uk) 

#Testing for the Proportional Hazards Assumption using the Schoenfeld Residuals Test
ph_test2_m <- cox.zph(cox_cvd_2_uk)
print(ph_test2_m)  


###Third model: (cox_cvd_2_uk) + general health related factors
cox_cvd_3_uk <- coxph(Surv(age_inclusion, age_inclusion + follow_up_time_cvd_uk, cvd_event_uk) ~ c9  + sex + edu + livingalone + work_cat + smoking +alcohol_3cat + fruitveg_cat + CNS + multimorbidity_index ,  data = sample_cvd_sensitivity_nofatal_uk)
summary(cox_cvd_3_uk)

#Testing for the Proportional Hazards Assumption using the Schoenfeld Residuals Test
ph_test3_m <- cox.zph(cox_cvd_3_uk)
print(ph_test3_m) 

#fourth model: (cox_cvd_3_uk) + cardiometabolic risk factors
cox_cvd_4_uk <- coxph(Surv(age_inclusion, age_inclusion + follow_up_time_cvd_uk, cvd_event_uk) ~ c9  + sex + edu + livingalone + work_cat + smoking +alcohol_3cat + fruitveg_cat + CNS + multimorbidity_index + bmi_cat + Hypertension_UK + Diabetes_UK + HYPLIP ,  data = sample_cvd_sensitivity_nofatal_uk)
summary(cox_cvd_4_uk)

#Testing for the Proportional Hazards Assumption using the Schoenfeld Residuals Test
ph_test4_m <- cox.zph(cox_cvd_4_uk)
print(ph_test4_m) 
