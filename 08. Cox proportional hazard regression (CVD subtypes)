## Figure 2: Hazard ratios from Cox proportional hazard models for the association between sleep-wake cycle profiles and types of cardiovascular disease events (coronary heart disease, heart failure and stroke) in the UKB accelerometer sub-study.  

# 8.3) Extraction of hazard ratios and confidence intervals from Cox models:
cox_results <- function(model, disease, model_label) {
  s <- summary(model)
  df <- data.frame(
    Variable = rownames(s$coefficients),
    HR = exp(s$coefficients[, "coef"]),
    Lower_CI = s$conf.int[, "lower .95"],
    Upper_CI = s$conf.int[, "upper .95"],
    p_value = s$coefficients[, "Pr(>|z|)"],
    stringsAsFactors = FALSE ) %>%
    filter(grepl("^SWCprofiles_UKB", Variable)) %>%
    mutate(Model = model_label,
           Disease = disease)
           
# 8.4) Addition of reference category 
  ref_row <- data.frame(
    Variable = "3.RAR+/LIPA+/Sleep+ (Ref.)",
    HR = 1,
    Lower_CI = 1,
    Upper_CI = 1,
    p_value = NA,
    Disease = disease,
    Model = model_label )
  
  df <- bind_rows(ref_row, df)

# 8.5) Relabeling of sleep–wake cycle profiles for plotting
  label_map <- c(
    "RAR ++ PA ++" = "1.RAR++/PA++",
    "RAR + PA + Sleep -" = "2.RAR+/PA+/Sleep-",
    "RAR + LIPA + Sleep +" = "3.RAR+/LIPA+/Sleep+ (Ref.)",
    "MVPA +" = "4.MVPA+",
     "RAR - Chronotype --" = "5.RAR-/Chronotype--",
    "RAR - PA - Sleep +" = "6.RAR-/PA-/Sleep+",
    "RAR - PA - Sleep --" = "7.RAR-/PA-/Sleep--",
    "RAR - PA + Restless sleep" = "8.RAR-/PA+/Restless sleep",
    "RAR -- PA -- Chronotype -" = "9.RAR--/PA--/Chronotype-")
  
  df <- df %>% mutate(Label = label_map[Variable])
  df}

# 8.6) Aggregation of Cox model results for coronary heart disease
results_all_CHD <- bind_rows(
  cox_results(cox_cvd_1_uk_CHD, "CORONARY HEART DISEASE", "Model 1"),
  cox_results(cox_cvd_2_uk_CHD, "CORONARY HEART DISEASE", "Model 2"),
  cox_results(cox_cvd_3_uk_CHD, "CORONARY HEART DISEASE", "Model 3"))

