#Note: Follow_up time: Participants were censored at the first date of their CVD event. 
#For example, if CHD was the outcome of interest and a participant experienced a HF event before CHD or the end of follow-up, 
#the censoring time was the date of HF.

# 8.1) Definition of cardiovascular disease event indicators
#8.1.1) CHD event indicator 
sample_cvd_uk$CHD_event_UK <- ifelse(
  sample_cvd_uk$CHD_incidence_UK == 1 &
    !is.na(sample_cvd_uk$first_cvd_date_UK) & !is.na(sample_cvd_uk$chd_out_sro_date) &
    sample_cvd_uk$first_cvd_date_UK == sample_cvd_uk$chd_out_sro_date & #First CVD date and CHD date are the same
    sample_cvd_uk$first_cvd_date_UK <= end_follow_up_date_CVD_uk, 1, 0) #First CVD date within observed follow-up

#8.1.2) HF event indicator
sample_cvd_uk$heart_f_event_uk <- ifelse(
  sample_cvd_uk$HF_incidence_UK == 1 & 
    !is.na(sample_cvd_uk$first_cvd_date_UK) & !is.na(sample_cvd_uk$hfailure_out_sro_date) &
    sample_cvd_uk$first_cvd_date_UK == sample_cvd_uk$hfailure_out_sro_date &
    sample_cvd_uk$first_cvd_date_UK <= end_follow_up_date_CVD_uk, 1, 0)

#8.1.3) Stroke event indicator
sample_cvd_uk$stroke_event_uk <- ifelse(
  sample_cvd_uk$Stroke_incidence_UK == 1 & 
    !is.na(sample_cvd_uk$first_cvd_date_UK) & !is.na(sample_cvd_uk$stroke_out_sro_date) &
    sample_cvd_uk$first_cvd_date_UK == sample_cvd_uk$stroke_out_sro_date &
    sample_cvd_uk$first_cvd_date_UK <= end_follow_up_date_CVD_uk, 1, 0)

