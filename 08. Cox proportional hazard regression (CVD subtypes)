  "7.RAR-/PA-/Sleep--", "8.RAR-/PA+/Restless sleep", "9.RAR--/PA--/Chronotype-"))
  
results_all_CHD$Label <- factor(results_all_CHD$Label, levels = plot_order_CHD)

