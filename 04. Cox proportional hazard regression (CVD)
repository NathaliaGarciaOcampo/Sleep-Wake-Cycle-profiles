  #4.2.0)   -------------------------------## **Cohort study: Whitehall II** ##---------------------------------
###----------------------------------------------------------------------------------------------------------###

#Creation of follow_up time and event indicator variables

#4.2.1) Follow-up time variable
end_follow_up_date_cvd <- as.Date("2023-03-31")  #End of follow up date for this study.

sample_cvd$end_date_cvd_WII <- pmin(
  sample_cvd$first_cvd_date, 
  sample_cvd$fup0923_s, 
  end_follow_up_date_cvd, 
  na.rm = TRUE)

sample_cvd$follow_up_time <- as.numeric( 
  difftime( sample_cvd$end_date_cvd_WII,  sample_cvd$fdatscrn,
    units = "days")) / 365.25 

#4.2.2) CVD event indicator 
sample_cvd$cvd_event <- ifelse(
!is.na(sample_cvd$first_cvd_date) & sample_cvd$first_cvd_date == sample_cvd$end_date_cvd_WII, 1, 0)

#4.2.3)Cox proportional hazard regressions, using age as time-scale:

#Model 1:
cox_cvd_1 <- coxph(Surv(fage_si, fage_si + follow_up_time, cvd_event) ~ SWCprofiles_WII + sex + edu + fstatus_cat + work + fesmoke_i + ffruit_cat + funitalcohol_cat,  data = sample_cvd)
summary(cox_cvd_1)
#Testing for the Proportional hazards assumption 
ph_test1_CVD_WII <- cox.zph(cox_cvd_1)

#Model 2:
cox_cvd_2 <- coxph(Surv(fage_si, fage_si + follow_up_time, cvd_event) ~ SWCprofiles_WII + sex + edu + fstatus_cat + work + fesmoke_i + ffruit_cat + funitalcohol_cat + multimorbidity_index + fcnsdrg_i ,  data = sample_cvd)
summary(cox_cvd_2)
#Testing for the Proportional hazards assumption 
ph_test2_CVD_WII  <- cox.zph(cox_cvd_2)

#Model 3:
cox_cvd_3 <- coxph(Surv(fage_si, fage_si + follow_up_time, cvd_event) ~ SWCprofiles_WII + sex + edu + fstatus_cat + work + fesmoke_i + ffruit_cat + funitalcohol_cat + multimorbidity_index + fcnsdrg_i + fbmi_cat + hypten_p + diabetes_p + hyplip ,  data = sample_cvd)
summary(cox_cvd_3) 
#Testing for the Proportional hazards assumption 
ph_test3_CVD_WII <- cox.zph(cox_cvd_3)



