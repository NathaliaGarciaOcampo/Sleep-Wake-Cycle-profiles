# 7.1) Excluding CVD fatal cases
sample_cvd_sensitivity_nofatal_uk <- sample_cvd_uk[
  !(sample_cvd_uk$cvd_event_uk == 1 & sample_cvd_uk$fatal_CVD_uk == 1),]

###------------------------------------------------------------------------------------------------------------------------------------------------
Table S4. Hazard ratios from Cox proportional hazard regression for the association between sleep-wake cycle profiles and incident non-fatal CVD in the UKB accelerometer sub-study.
#Note: The results from these models were used to generate this table, which was formatted separately for publication. This script reproduces the statistical models underlying the reported results.

# 7.2) Cox proportional hazards regression analyses using age as the time scale:

##Model 1:
cox_cvd_1_uk <- coxph(Surv(age_inclusion, age_inclusion + follow_up_time_cvd_uk, cvd_event_uk) ~ SWCprofiles_UKB  + sex + edu + livingalone + work_cat + smoking +alcohol_3cat + fruitveg_cat,  data = sample_cvd_sensitivity_nofatal_uk)
summary(cox_cvd_1_uk) 
#Testing the proportional hazard assumption
ph_test1_m <- cox.zph(cox_cvd_1_uk)

##Model 2: 
cox_cvd_2_uk <- coxph(Surv(age_inclusion, age_inclusion + follow_up_time_cvd_uk, cvd_event_uk) ~ SWCprofiles_UKB  + sex + edu + livingalone + work_cat + smoking +alcohol_3cat + fruitveg_cat + CNS + multimorbidity_index ,  data = sample_cvd_sensitivity_nofatal_uk)
summary(cox_cvd_2_uk)
#Testing the proportional hazard assumption
ph_test2_m <- cox.zph(cox_cvd_2_uk)

##Model 3: 
cox_cvd_3_uk <- coxph(Surv(age_inclusion, age_inclusion + follow_up_time_cvd_uk, cvd_event_uk) ~ SWCprofiles_UKB  + sex + edu + livingalone + work_cat + smoking +alcohol_3cat + fruitveg_cat + CNS + multimorbidity_index + bmi_cat + Hypertension_UK + Diabetes_UK + HYPLIP ,  data = sample_cvd_sensitivity_nofatal_uk)
summary(cox_cvd_3_uk)
#Testing the proportional hazard assumption
ph_test3_m <- cox.zph(cox_cvd_3_uk)
