  sample_cvd_uk$SWCprofiles_UKB,levels = c( "SWCprofiles_UKBProfile 1", "SWCprofiles_UKBProfile 2", "SWCprofiles_UKBProfile 3",  "SWCprofiles_UKBProfile 4",
